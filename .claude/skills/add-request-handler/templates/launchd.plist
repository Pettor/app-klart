<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Klart request handler "__ID__", generated by /add-request-handler. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.klart.requests.__ID__</string>
  <key>ProgramArguments</key>
  <array>
    <!-- A login shell, so the commands get the same PATH as in Terminal. -->
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>'__SCRIPT__'</string>
  </array>
  <key>StartInterval</key>
  <integer>__INTERVAL_SECONDS__</integer>
  <!-- __WATCH_PATHS__ -->
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err</string>
</dict>
</plist>
