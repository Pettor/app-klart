{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klart",
  "version": "../package.json",
  "identifier": "app.klart.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @app/web exec vite --port 1420 --strictPort"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klart",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Plan today from what's due.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
