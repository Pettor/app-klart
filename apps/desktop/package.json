{
  "name": "@app/desktop",
  "version": "0.16.0",
  "description": "Klart desktop app: the web build packaged with Tauri",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf ../../output/build",
    "clean:all": "pnpm clean && rimraf node_modules src-tauri/target",
    "dev": "tauri dev",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tauri build && node scripts/collect-artifacts.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@app/web": "workspace:*",
    "@tauri-apps/cli": "catalog:dev",
    "rimraf": "catalog:dev",
    "sharp": "catalog:dev"
  }
}
